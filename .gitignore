# Dependencies and build output — both regenerated by `npm ci && npm run build`.
node_modules/
dist/

# QA harness output (scripts/shots.mjs).
shots/

# Archives. A zip of the site left in the tree once ended up inside dist/,
# where it would have been publicly downloadable after upload — which is
# exactly what `npm run zip` avoids by writing outside the folder it packs.
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Local overrides. `.env` itself IS committed: it holds the deploy base and
# the production domain, no secrets, and a clone needs it to build correctly.
# Anything private belongs in .env.local, which is ignored here.
*.local
.env.local
.env.*.local

.DS_Store
Thumbs.db

# Route documents composed by scripts/pages.mjs from src/pages/. They are
# build output, not source: `prebuild` regenerates all four before every
# dev run and every build, and they carry the build id, so committing them
# would dirty four files every time a single image in public/ changed.
/index.html
/about/
/services/
/contact/

# Label tables generated into the PHP endpoint by scripts/labels.mjs, from
# src/config/enquiry.js. Build output, regenerated before every build.
public/api/labels.php

# Local Worker secrets for `wrangler dev` (RESEND_API_KEY etc.). Never committed.
.dev.vars

# wrangler local state (miniflare, the local D1 database, dev caches).
.wrangler/

# Shared-hosting settings for api/contact.php: passwords. Upload it above
# public_html by hand; the .example next to it is the committed template.
fkr-contact.env
