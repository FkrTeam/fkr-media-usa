# Dependencies and build output — both regenerated by `npm ci && npm run build`.
node_modules/
dist/

# QA harness output (scripts/shots.mjs).
shots/

# Archives. A zip of the site left in the tree once ended up inside dist/,
# where it would have been publicly downloadable after upload.
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Local overrides. `.env` itself IS committed: it holds the deploy base and
# the production domain, no secrets, and a clone needs it to build correctly.
# Anything private belongs in .env.local, which is ignored here.
*.local
.env.local
.env.*.local

.DS_Store
Thumbs.db

# Route documents composed by scripts/pages.mjs from src/pages/. They are
# build output, not source: `prebuild` regenerates all four before every
# dev run and every build, and they carry the build id, so committing them
# would dirty four files every time a single image in public/ changed.
/index.html
/about/
/services/
/contact/
