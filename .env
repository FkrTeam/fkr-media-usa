# ── Where the site is served from ────────────────────────────────────────
#
#   Domain root            VITE_BASE=/
#   Sub-directory          VITE_BASE=/fkr-media-usa/
#
# Change this ONE line, run `npm run build`, upload dist/.
# Both the asset URLs and the internal links follow it.
VITE_BASE=/fkr-media-usa/

# ── The production domain ────────────────────────────────────────────────
#
# Used for canonical, Open Graph and JSON-LD URLs only. Keep it pointed at
# the real site even while testing elsewhere: that is what tells search
# engines the staging copy is not the original.
VITE_SITE_URL=https://fkrmediausa.com
