# FKR Media USA — contact form settings for a shared Linux host.
#
# Copy this file to `fkr-contact.env`, fill it in, and upload it to the
# directory ABOVE public_html (the account's home directory), so the web
# server can never serve it. api/contact.php finds it there by itself.
# `fkr-contact.env` is ignored by git and must never be committed.
#
# On the Cloudflare deploy none of this is used: the same settings live in
# wrangler.jsonc (the non-secret ones) and in `wrangler secret put` (the
# passwords).

# ── MySQL ────────────────────────────────────────────────────────────────
# On shared hosting the database is on the same machine, so localhost.
MYSQL_HOST=localhost
MYSQL_PORT=3306
# cPanel prefixes both with the account name, e.g. fkrmedia_form / fkrmedia_www
MYSQL_DATABASE=account_databasename
MYSQL_USER=account_username
MYSQL_PASSWORD=
# "require" only if the host says its MySQL offers TLS; irrelevant on localhost.
MYSQL_SSL=prefer

# ── Outgoing mail (the hosting account's own mailbox) ────────────────────
SMTP_HOST=mail.fkrmediausa.com
# 465 with SMTP_SECURE=tls (preferred), or 587 with SMTP_SECURE=starttls
SMTP_PORT=465
SMTP_SECURE=tls
# Usually the full address of the mailbox
SMTP_USER=hello@fkrmediausa.com
SMTP_PASS=

# The mailbox the form sends as — the one SMTP_USER logs in to; most hosts
# refuse to send as anyone else.
MAIL_FROM="FKR Media USA <hello@fkrmediausa.com>"
# Where enquiries are delivered. Several: separate with commas.
MAIL_TO=hello@fkrmediausa.com

# ── Privacy ──────────────────────────────────────────────────────────────
# Any long random string. Visitors' IP addresses are hashed with it for the
# rate limit and never stored as they are.
IP_SALT=
