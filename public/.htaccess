# FKR MEDIA USA — cache policy for the static build.
#
# Uploaded as part of dist/. Apache only; on nginx it is inert and the same
# rules belong in the server block (see README, "Caching on the server").
#
# The build has two kinds of file and they want opposite treatment:
#
#   assets/…            Vite writes a content hash INTO the filename, so a
#                       given URL can only ever mean one exact file. Cache
#                       these as hard as possible and never revalidate.
#
#   *.html              Stable names, changing contents, and they are what
#                       names the hashed bundle. If a visitor holds a stale
#                       document they stay pinned to an old build no matter
#                       how correct everything else is. Always revalidate.
#
#   images, media, …    Copied verbatim out of public/, so the path never
#                       changes — but every request the app makes for one
#                       carries ?v=<hash of public/>, which does. Safe to
#                       cache for a long time: replacing a logo changes the
#                       query and the browser treats it as a new URL.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|mp4|webm|m4v)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ETags are derived from the inode on many shared hosts, so the same file
# served from two machines gets two tags and revalidation never succeeds.
# Last-Modified is enough here.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── HTTPS, and only HTTPS ──────────────────────────────────────────────
#
# Everything arrives over TLS or is redirected to it, before any other rule
# runs. The contact form posts a name, an email address and a message, and
# a single plaintext request would put all three on the wire in the clear.
#
# The condition tests three things because a shared host can present the
# request in any of these ways: %{HTTPS} is off on a direct plain request;
# X-Forwarded-Proto is what a proxy or load balancer in front of the server
# sets; X-Forwarded-SSL is LiteSpeed's older spelling of the same thing.
# Testing only the first would redirect forever behind a terminating proxy.
#
# 301, not 302: browsers remember it, so the second visit never makes the
# plaintext request at all.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# HSTS tells the browser to never try plaintext for this host again, so a
# typed "fkrmediausa.com" skips the redirect entirely. Two years, and
# subdomains included.
#
# BEFORE ENABLING, be sure every subdomain that exists has a certificate:
# includeSubDomains makes an http-only subdomain unreachable, and the
# browser holds that instruction for the full max-age even if this header
# is later removed. Drop `includeSubDomains` if that is not certain.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>

# No directory listings. Every route ships an index.html, so a listing only
# ever appears where something is missing — and then it shows the contents
# of the directory to anyone who asks.
Options -Indexes

# ── Contact form endpoint ──────────────────────────────────────────────
#
# The form posts to <base>/api/contact. On Cloudflare a Worker answers it;
# here api/contact.php does. The path is a file, not a directory, so no
# trailing-slash redirect ever turns the POST into a GET.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
</IfModule>

# smtp.php is a library, not a page (it also refuses to run on its own).
<Files "smtp.php">
  Require all denied
</Files>

# Settings and schema files are never web content, wherever they end up.
<FilesMatch "\.(env|sql|example)$">
  Require all denied
</FilesMatch>

# The endpoint's replies are never cacheable.
<Files "contact.php">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
  </IfModule>
</Files>
